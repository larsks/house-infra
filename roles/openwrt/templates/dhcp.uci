config dnsmasq 'dnsmasq'
{% for key in (host.data.dnsmasq_options|default({})).keys() %}
  option {{ key }} {% if dnsmasq_options[key] is integer %}{{ dnsmasq_options[key] }}{% else %}'{{ dnsmasq_options[key] }}'{% endif %}
{% endfor %}
  option domain '{{ host.data.dnsmasq_domain }}'
  option local '/{{ host.data.dnsmasq_domain }}/'
  option domainneeded 1
  option boguspriv  1
  option localise_queries 1
  option rebind_protection {{ host.data.dnsmasq_rebind_protection }}
  option rebind_localhost {{ host.data.dnsmasq_rebind_localhost }}
  option expandhosts  1
  option nonegcache 0
  option authoritative  {{ host.data.dnsmasq_authoritative }}
  option readethers 1
  option leasefile  '{{ host.data.dnsmasq_lease_file }}'
  option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
  option nonwildcard  1
  option localservice 1
  option ednspacket_max 1232

{% for vlan in host.data.vlans %}
{% if vlan.dhcp|default(false) %}
{% set pool = vlan.cidr | dhcp_pool %}
config dhcp 'vlan{{ vlan.id }}'
  option interface  'vlan{{ vlan.id }}'
  option start  {{ vlan.dhcp_start|default(pool.start) }}
  option limit  {{ vlan.dhcp_limit|default(pool.limit) }}
  option leasetime  {{ vlan.dhcp_leasetime|default('12h') }}

{% endif %}
{% endfor %}
