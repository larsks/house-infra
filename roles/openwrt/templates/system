config system
  option hostname '{{ inventory_hostname }}'
  option timezone 'GMT0'
  option zonename 'UTC'
  option ttylogin '0'
  option log_size '128'
  option urandom_seed '0'
  option compat_version '1.0'
  option conloglevel '8'
  option cronloglevel '7'
{% for key in system.keys() %}
  option {{ key }} '{{ system[key] }}'
{% endfor %}

{% if ntp.enabled|default(false)|bool %}
config timeserver 'ntp'
{% for server in ntp.servers|default([]) %}
  list server {{ server }}
{% endfor %}
{% endif %}
